.sart{position:relative;aspect-ratio:16/9;min-height:14rem}
.sart>svg{position:absolute;inset:0;width:100%;height:100%;display:block}
.sfade{position:absolute;inset:0;background:linear-gradient(0deg,var(--surface) 2%,#16182100 62%)}
.shead{position:absolute;left:0;right:0;bottom:0;padding:1rem clamp(1rem,4vw,2.2rem);display:grid;gap:.8rem}
.shead h2{margin:0;font:800 clamp(2rem,6vw,3.4rem)/.95 var(--font-display);letter-spacing:-.035em;text-wrap:balance}
.sbody{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:1rem 2rem;padding:.4rem clamp(1rem,4vw,2.2rem) 1rem}
