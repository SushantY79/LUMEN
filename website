  --font-display:'Bricolage Grotesque','Arial Narrow',system-ui,sans-serif;
  --font-body:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font:400 15px/1.5 var(--font-body);min-height:100%}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--fg);outline-offset:2px}
.wrap{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:60;background:var(--bg)}

/* top bar */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--glass);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.top-in{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem 1.4rem;padding-block:.7rem}
.logo{display:flex;align-items:center;gap:.55rem;font:800 1.65rem/1 var(--font-display);letter-spacing:-.045em;background:none;border:0;padding:0;cursor:pointer}
.logo i{width:.9rem;height:.9rem;border-radius:50%;background:var(--accent);box-shadow:0 0 0 .22rem #ff6a3d40,0 0 1.2rem #ff6a3d99}
.nav{display:flex;gap:.2rem;overflow-x:auto;scrollbar-width:none;min-width:0}
.nav button{background:none;border:0;padding:.45rem .8rem;border-radius:6px;color:var(--muted);cursor:pointer;font-weight:500;white-space:nowrap}
.nav button:hover{color:var(--fg)}
.nav button[aria-current=page]{color:var(--fg);background:var(--surface-2)}
.search{margin-left:auto;position:relative;display:flex;align-items:center;min-width:0}
.search svg{position:absolute;left:.65rem;color:var(--muted);pointer-events:none}
.search input{background:var(--surface);border:1px solid var(--line);border-radius:6px;color:var(--fg);padding:.5rem .8rem .5rem 2.1rem;width:min(16rem,100%);font:inherit;min-width:0}
.search input::placeholder{color:var(--muted)}
.avatar{width:2.1rem;height:2.1rem;border-radius:6px;background:linear-gradient(135deg,#ff6a3d,#7a3cff);display:grid;place-items:center;font:700 .95rem var(--font-display);color:#fff;flex:none}
@media (max-width:719px){.search{flex:1 1 8rem}.nav{order:5;width:100%}}

/* hero */
.hero{position:relative;isolation:isolate;overflow:hidden}
.hero-art{position:absolute;inset:0;z-index:-2}
.hero-art svg{width:100%;height:100%;display:block}
.hero::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,var(--bg) 0%,#0c0d12b8 38%,#0c0d1200 78%),linear-gradient(0deg,var(--bg) 0%,#0c0d1200 45%)}
@media (max-width:719px){.hero::after{background:linear-gradient(0deg,var(--bg) 8%,#0c0d12b3 55%,#0c0d1255 100%)}}
.hero-in{padding-block:clamp(4rem,11vw,8.5rem) clamp(2rem,5vw,3.5rem)}
.hero-copy{max-width:34rem;display:grid;gap:.9rem;justify-items:start}
.eyebrow{margin:0;display:flex;align-items:center;gap:.5rem;font-size:.75rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.eyebrow i{width:.55rem;height:.55rem;background:var(--accent);border-radius:50%}
.hero h1{margin:0;font:800 clamp(2.8rem,8.5vw,5.6rem)/.92 var(--font-display);letter-spacing:-.035em;text-wrap:balance}
.hmeta,.smeta{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem .9rem;margin:0;color:var(--muted);font-size:.9rem}
.match{color:var(--good);font-weight:600}
.chip{border:1px solid var(--line-strong);border-radius:4px;padding:0 .4rem;font-size:.78rem;color:var(--fg)}
.blurb{margin:0;font-size:1.05rem;max-width:32rem;text-wrap:pretty}
.actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:.3rem}
.btn{display:inline-flex;align-items:center;gap:.5rem;border:0;border-radius:6px;padding:.7rem 1.3rem;font-weight:600;font-size:1rem;cursor:pointer}
.btn.primary{background:var(--accent);color:var(--accent-ink)}
.btn.ghost{background:#ffffff26;color:var(--fg);backdrop-filter:blur(6px)}
.btn:hover{filter:brightness(1.12)}

/* rows and tiles */
.row h2{margin:1.1rem 0 0;font:700 1.2rem/1.2 var(--font-display);letter-spacing:-.01em}
.railwrap{position:relative}
.rail{display:flex;gap:.55rem;align-items:flex-start;overflow-x:auto;scroll-snap-type:x proximity;scrollbar-width:none;padding-top:1.1rem;padding-bottom:1.9rem;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));scroll-padding-left:max(16px,env(safe-area-inset-left,0px))}
.rail::-webkit-scrollbar{display:none}
.rail>*{scroll-snap-align:start}
.arrow{position:absolute;top:1.1rem;bottom:1.9rem;width:3.2rem;z-index:6;border:0;display:none;align-items:center;justify-content:center;cursor:pointer;color:var(--fg)}
.arrow.l{left:0;background:linear-gradient(90deg,var(--bg),#0c0d1200)}
.arrow.r{right:0;background:linear-gradient(270deg,var(--bg),#0c0d1200)}
