    var cx=W*(.5+r()*.15),cy=H*.5;
    for(var j=1;j<=5;j++){var rad=H*(.12+j*.11),ang=r()*6.283;
      s+='<circle cx="'+n(cx)+'" cy="'+n(cy)+'" r="'+n(rad)+'" fill="none" stroke="hsl('+b+' 80% 75%)" stroke-opacity=".28" stroke-width="'+n(H/180+.5)+'"/>';
      s+='<circle cx="'+n(cx+Math.cos(ang)*rad)+'" cy="'+n(cy+Math.sin(ang)*rad)+'" r="'+n(H*.018+r()*H*.02)+'" fill="hsl('+b+' 95% 78%)"/>'}
    s+='<circle cx="'+n(cx)+'" cy="'+n(cy)+'" r="'+n(H*.1)+'" fill="hsl('+b+' 95% 68%)"/>';
  }else if(M==='forest'){
    s+=disc(W*.7,H*.3,H*.1,.8);
    for(var ly=0;ly<3;ly++){var base=H*(.7+ly*.14),sz=H*(.22+ly*.1),fx=-sz/2;
      while(fx<W+sz){var th=sz*(.8+r()*.6);
        s+='<polygon points="'+n(fx)+','+n(base)+' '+n(fx+sz*.3)+','+n(base-th)+' '+n(fx+sz*.6)+','+n(base)+'" fill="hsl('+a+' 45% '+(16-ly*5)+'%)"/>';
        fx+=sz*(.35+r()*.2)}}
    s+='<rect y="'+n(H*.95)+'" width="'+W+'" height="'+n(H*.05)+'" fill="hsl('+a+' 50% 5%)"/>';
  }else{
    s+=disc(W*.75,H*.35,H*.18,.8);
    for(var m=0;m<7;m++){var bx=W*(-.1+m*.17+r()*.05),bw=W*(.04+r()*.05);
      s+='<polygon points="'+n(bx)+',0 '+n(bx+bw)+',0 '+n(bx+bw+W*.25)+','+H+' '+n(bx+W*.25)+','+H+'" fill="hsl('+b+' 90% 70%)" opacity="'+n(.08+r()*.12)+'"/>'}
    s+=ridge(H*.88,H*.12,'hsl('+a+' 50% 7%)',10);
  }
  return '<svg viewBox="0 0 '+W+' '+H+'" preserveAspectRatio="xMidYMid slice" aria-hidden="true">'+s+'</svg>';
}

/* ---------- state ---------- */
var view='home',Q='',list=null,lastFocus=null;
try{list=JSON.parse(localStorage.getItem('lumen:list')||'null')}catch(e){}
if(!Array.isArray(list))list=['kiln','staticbloom','deepfield'];
list=list.filter(function(id){return byId[id]});
var save=function(){try{localStorage.setItem('lumen:list',JSON.stringify(list))}catch(e){}};
var inList=function(id){return list.indexOf(id)>=0};

var I={
  play:'<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>',
  plus:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>',
  check:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>',
  info:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.01"/></svg>',
  x:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>',
  l:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>',
  r:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>'
};

/* ---------- html builders ---------- */
function addBtn(id){var on=inList(id);return '<button class="add'+(on?' on':'')+'" data-add="'+id+'" aria-pressed="'+on+'" aria-label="'+(on?'Remove from My List: ':'Add to My List: ')+esc(byId[id].title)+'">'+(on?I.check:I.plus)+'</button>'}
function tile(t,o){o=o||{};
  return '<div class="tile'+(o.port?' port':'')+'"><button class="open" data-open="'+t.id+'" aria-label="'+esc(t.title)+', open details">'+scene(t,o.port?200:320,o.port?300:180)+
  '<span class="cap"><b class="ttl">'+esc(t.title)+'</b><span class="meta">'+t.match+'% match · '+t.year+' · '+t.rating+' · '+t.len+'</span></span>'+
  (o.p?'<span class="prog"><i style="width:'+o.p+'%"></i></span>':'')+'</button>'+addBtn(t.id)+'</div>';
}
function row(title,items,o){o=o||{};
  if(items.length<(o.min||2))return '';
  var inner=items.map(function(t,i){return o.top?'<div class="t10"><span class="num" aria-hidden="true">'+(i+1)+'</span>'+tile(t,{port:true})+'</div>':tile(t,{p:o.prog&&o.prog[t.id]})}).join('');
  return '<section class="row"><h2 class="wrap">'+esc(title)+'</h2><div class="railwrap"><button class="arrow l" data-scroll="-1" aria-label="Scroll left">'+I.l+'</button><div class="rail">'+inner+'</div><button class="arrow r" data-scroll="1" aria-label="Scroll right">'+I.r+'</button></div></section>';
}
function grid(items){return '<div class="grid-list">'+items.map(function(t){return tile(t)}).join('')+'</div>'}
function listRow(){return row('My List',list.map(function(id){return byId[id]}),{min:1})}
function hero(t){
  return '<section class="hero"><div class="hero-art">'+scene(t,1600,700)+'</div><div class="wrap hero-in"><div class="hero-copy">'+
  '<p class="eyebrow"><i></i>Lumen Original '+(t.type==='film'?'Film':'Series')+'</p><h1>'+esc(t.title)+'</h1>'+
  '<p class="hmeta"><span class="match">'+t.match+'% match</span><span>'+t.year+'</span><span class="chip">'+t.rating+'</span><span>'+t.len+'</span></p>'+
  '<p class="blurb">'+esc(t.blurb)+'</p><div class="actions"><button class="btn primary" data-play="'+t.id+'">'+I.play+'Play</button><button class="btn ghost" data-open="'+t.id+'">'+I.info+'More info</button></div></div></div></section>';
}
var FOOT='<footer class="wrap foot"><p>Lumen is a fictional streaming service. Every title, name and plot on this page is invented, and nothing here plays.</p></footer>';

function render(){
  var q=Q.trim().toLowerCase(),h='';
  document.querySelectorAll('.nav button').forEach(function(b){if(!q&&b.dataset.view===view)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current')});
  if(q){
    var res=T.filter(function(t){return (t.title+' '+t.genres.join(' ')+' '+t.type+' '+t.year).toLowerCase().indexOf(q)>=0});
    h='<div class="wrap page"><h2 class="ph">'+(res.length?'Results for “'+esc(Q.trim())+'”':'No titles match “'+esc(Q.trim())+'”')+'</h2>'+(res.length?grid(res):'<p class="empty">Try a genre such as Comedy, Thriller or Documentary, or part of a title.</p>')+'</div>';
  }else if(view==='list'){
    var items=list.map(function(id){return byId[id]});
    h='<div class="wrap page"><h2 class="ph">My List</h2>'+(items.length?grid(items):'<p class="empty">Nothing saved yet. Use the + on any title to keep it here.</p>')+'</div>';
  }else{
    var base=T.filter(function(t){return view==='home'||(view==='series'?t.type==='series':t.type==='film')});
    var inBase=function(id){return base.indexOf(byId[id])>=0};
    var by=function(gs){return base.filter(function(t){return t.genres.some(function(g){return gs.indexOf(g)>=0})})};
    h=hero(byId[HERO[view]]);
    h+=row(view==='home'?'Trending Now':view==='series'?'Popular Series':'Popular Films',TREND.filter(inBase).map(function(id){return byId[id]}));
    if(view==='home'){
      h+=row('Continue Watching',Object.keys(CONT).map(function(id){return byId[id]}),{prog:CONT});
      h+='<div id="slot">'+listRow()+'</div>';
      h+=row('Top 10 This Week',TOP.map(function(id){return byId[id]}),{top:true});
    }
    h+=row('Sci-Fi & Fantasy',by(['Sci-Fi','Fantasy']));
    h+=row('Crime, Thrillers & Mystery',by(['Crime','Thriller','Mystery']));
    h+=row('Comedies',by(['Comedy']));
    h+=row('Drama & Romance',by(['Drama','Romance']));
    h+=row('Documentaries',by(['Documentary']));
    h+=row('Family & Animation',by(['Family','Animation']));
    h+=row('New in 2026',base.filter(function(t){return t.year===2026}));
  }
  $('#app').innerHTML=h+FOOT;
}

/* ---------- detail sheet ---------- */
function modalHTML(t){
  var r=rng(t.id+'c'),cast=[],pool=CAST.slice();
  for(var i=0;i<3;i++)cast.push(pool.splice(Math.floor(r()*pool.length),1)[0]);
  var eps='';
  if(t.type==='series'){
    var re=rng(t.id+'e'),ep=EP.slice(),out=[];
    for(var k=0;k<5;k++)out.push(ep.splice(Math.floor(re()*ep.length),1)[0]);
    eps='<div class="sec"><h3>Episodes</h3><ol class="eps">'+out.map(function(nm,k2){
      var th={id:t.id+'-'+k2,h1:t.h1,h2:t.h2,motif:t.motif};
      return '<li class="ep"><span class="en">'+(k2+1)+'</span><div class="ethumb">'+scene(th,160,90)+'</div><div><strong>'+esc(nm)+'</strong><span>'+(38+Math.floor(re()*18))+'m</span></div></li>'}).join('')+'</ol></div>';
  }
  var sim=T.filter(function(x){return x.id!==t.id&&x.genres.some(function(g){return t.genres.indexOf(g)>=0})});
  T.forEach(function(x){if(x.id!==t.id&&sim.indexOf(x)<0)sim.push(x)});
  sim=sim.slice(0,6);
  return '<div class="sheet" role="dialog" aria-modal="true" aria-labelledby="mt"><button class="x" data-close aria-label="Close">'+I.x+'</button>'+
  '<div class="sart">'+scene(t,1280,720)+'<div class="sfade"></div><div class="shead"><h2 id="mt">'+esc(t.title)+'</h2><div class="actions"><button class="btn primary" data-play="'+t.id+'">'+I.play+'Play</button><button class="btn ghost" data-add="'+t.id+'" data-label="text"></button></div></div></div>'+
  '<div class="sbody"><div><p class="smeta"><span class="match">'+t.match+'% match</span><span>'+t.year+'</span><span class="chip">'+t.rating+'</span><span>'+t.len+'</span></p><p class="sblurb">'+esc(t.blurb)+'</p></div>'+
  '<dl class="sside"><div><dt>Cast:</dt><dd>'+cast.map(esc).join(', ')+'</dd></div><div><dt>Genres:</dt><dd>'+t.genres.join(', ')+'</dd></div><div><dt>Format:</dt><dd>'+(t.type==='film'?'Feature film':'Series')+'</dd></div></dl></div>'+
  eps+'<div class="sec"><h3>More like this</h3>'+grid(sim)+'</div></div>';
}
var scrim=$('#scrim');
function openModal(id,from){
  var t=byId[id];if(!t)return;
  if(scrim.hidden){lastFocus=from||document.activeElement;document.documentElement.style.overflow='hidden'}
  scrim.innerHTML=modalHTML(t);scrim.hidden=false;scrim.scrollTop=0;
  syncAdd(id);
  var x=scrim.querySelector('.x');if(x)x.focus();
}
function closeModal(){
  scrim.hidden=true;scrim.innerHTML='';document.documentElement.style.overflow='';
  if(lastFocus&&lastFocus.focus&&document.contains(lastFocus))lastFocus.focus();
}

/* ---------- actions ---------- */
function syncAdd(id){
  var on=inList(id);
  document.querySelectorAll('[data-add="'+id+'"]').forEach(function(b){
    var txt=b.dataset.label==='text';
    b.classList.toggle('on',on);b.setAttribute('aria-pressed',on);
    b.setAttribute('aria-label',(on?'Remove from My List: ':'Add to My List: ')+byId[id].title);
    b.innerHTML=(on?I.check:I.plus)+(txt?'<span>'+(on?'In My List':'My List')+'</span>':'');
  });
}
function toggle(id){
  var i=list.indexOf(id);if(i>=0)list.splice(i,1);else list.push(id);
  save();syncAdd(id);
  toast((inList(id)?'Added to My List: ':'Removed from My List: ')+byId[id].title);
  if(!Q.trim()&&view==='list'){render()}
  else{var s=$('#slot');if(s)s.innerHTML=listRow()}
}
var toastT;
function toast(msg){var el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastT);toastT=setTimeout(function(){el.classList.remove('show')},2600)}
var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;

document.addEventListener('click',function(e){
  var el=e.target.closest('[data-open],[data-add],[data-play],[data-view],[data-scroll],[data-close]');
  if(!el)return;
  var d=el.dataset;
  if('close' in d)closeModal();
  else if('open' in d)openModal(d.open,el);
  else if('add' in d)toggle(d.add);
  else if('play' in d)toast('Playback isn\'t part of this demo: '+byId[d.play].title+' is a made-up title.');
  else if('view' in d){view=d.view;Q='';$('#q').value='';if(!scrim.hidden)closeModal();render();window.scrollTo(0,0)}
  else if('scroll' in d){var rail=el.parentElement.querySelector('.rail');rail.scrollBy({left:d.scroll*rail.clientWidth*.85,behavior:reduce?'auto':'smooth'})}
});
scrim.addEventListener('click',function(e){if(e.target===scrim)closeModal()});
document.addEventListener('keydown',function(e){
  if(scrim.hidden)return;
  if(e.key==='Escape'){closeModal();return}
  if(e.key==='Tab'){
    var f=[].slice.call(scrim.querySelectorAll('button')).filter(function(b){return !b.disabled&&b.offsetParent!==null});
    if(!f.length)return;
    var first=f[0],last=f[f.length-1];
    if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}
    else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}
  }
});
$('#q').addEventListener('input',function(e){Q=e.target.value;render()});

render();
})();
</script>

</body></html>