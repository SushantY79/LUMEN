.sblurb{margin:.8rem 0 0;font-size:1.02rem;text-wrap:pretty}
.sside{margin:.8rem 0 0;display:grid;gap:.7rem;font-size:.88rem;align-content:start}
.sside dt{color:var(--muted);display:inline}
.sside dt::after{content:" "}
.sside dd{margin:0;display:inline}
.sec{padding:0 clamp(1rem,4vw,2.2rem) 1.4rem}
.sec h3{margin:.6rem 0 .8rem;font:700 1.15rem var(--font-display)}
.eps{list-style:none;margin:0;padding:0;display:grid}
.ep{display:grid;grid-template-columns:1.6rem 7.5rem minmax(0,1fr);gap:.9rem;align-items:center;padding:.7rem .4rem;border-top:1px solid var(--line)}
.ep:first-child{border-top:0}
.en{color:var(--muted);font:600 1.1rem var(--font-display);text-align:center}
.ethumb{aspect-ratio:16/9;border-radius:4px;overflow:hidden;position:relative}
.ethumb svg{position:absolute;inset:0;width:100%;height:100%;display:block}
.ep strong{display:block;font-weight:600}
.ep span{color:var(--muted);font-size:.85rem}
@media (max-width:480px){.ep{grid-template-columns:1.2rem 5.5rem minmax(0,1fr);gap:.6rem}}

.toast{position:fixed;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 1.2rem);transform:translate(-50%,16px);opacity:0;pointer-events:none;background:var(--fg);color:var(--bg);padding:.7rem 1rem;border-radius:8px;font-weight:500;max-width:calc(100% - 2rem);transition:opacity .2s,transform .2s;z-index:200}
.toast.show{opacity:1;transform:translate(-50%,0)}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}.tile:hover,.tile:focus-within{transform:none}}
</style>

