.tile .open{display:block;width:100%;height:100%;padding:0;border:0;background:var(--surface);border-radius:6px;overflow:hidden;position:relative;text-align:left;cursor:pointer}
.tile .open svg{position:absolute;inset:0;width:100%;height:100%;display:block}
.cap{position:absolute;inset:auto 0 0;padding:1.8rem .7rem .6rem;background:linear-gradient(#00000000,#000000d0);display:grid;gap:.15rem}
.ttl{font:700 1rem/1.1 var(--font-display);letter-spacing:-.01em;text-wrap:balance}
.meta{font-size:.72rem;color:#d6d9e4;max-height:0;opacity:0;overflow:hidden;transition:max-height .2s,opacity .2s}
.prog{position:absolute;left:0;right:0;bottom:0;height:3px;background:#ffffff33}
.prog i{display:block;height:100%;background:var(--accent)}
.add{position:absolute;top:.4rem;right:.4rem;width:2rem;height:2rem;border-radius:50%;border:1px solid #ffffff66;background:#000000aa;display:grid;place-items:center;cursor:pointer;z-index:2}
.add.on{background:var(--fg);color:var(--bg);border-color:var(--fg)}
@media (hover:hover){
  .add{opacity:0;transition:opacity .15s}
  .tile:hover,.tile:focus-within{transform:scale(1.1);z-index:5;box-shadow:0 14px 40px #000000b3}
  .tile:hover .add,.tile:focus-within .add{opacity:1}
  .tile:hover .meta,.tile:focus-within .meta{max-height:2.6rem;opacity:1}
}
.t10{display:flex;align-items:flex-end;flex:0 0 auto}
.num{font:800 clamp(7rem,13vw,10rem)/.78 var(--font-display);color:transparent;-webkit-text-stroke:3px var(--line-strong);letter-spacing:-.09em;margin-right:-.5rem;position:relative;z-index:0;padding-bottom:.4rem}
.t10 .tile{z-index:1}
.grid-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,210px),1fr));gap:1.3rem .6rem}
.grid-list .tile{flex:none;width:100%}
.page{padding-block:2rem 1rem}
.ph{margin:0 0 1.4rem;font:700 1.6rem/1.2 var(--font-display);letter-spacing:-.02em}
.empty{color:var(--muted);max-width:30rem}
.foot{padding-block:2.5rem 4rem;color:var(--muted);font-size:.85rem;border-top:1px solid var(--line);margin-top:1rem}
.foot p{margin:0;max-width:40rem}

/* detail sheet */
.scrim{position:fixed;inset:0;z-index:100;background:#000000b8;overflow-y:auto;padding-top:calc(env(safe-area-inset-top,0px) + 1.5rem);padding-bottom:calc(env(safe-area-inset-bottom,0px) + 2rem);padding-left:max(12px,env(safe-area-inset-left,0px));padding-right:max(12px,env(safe-area-inset-right,0px))}
.sheet{width:min(54rem,100%);margin:0 auto;background:var(--surface);border-radius:10px;overflow:hidden;position:relative;box-shadow:0 30px 80px #000}
